{
    "name": "iarash84/yii2-kamancms",
    "description": "Yii2-KamanCms multilingual content management system",
    "keywords": ["yii2", "cms", "content-management", "multilingual"],
    "homepage": "https://github.com/iarash84/Yii2-KamanCms",
    "type": "project",
    "license": "BSD-3-Clause",
    "support": {
        "issues": "https://github.com/iarash84/Yii2-KamanCms/issues",
        "source": "https://github.com/iarash84/Yii2-KamanCms"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": "^8.2",
        "yiisoft/yii2": "~2.0.55",
        "yiisoft/yii2-symfonymailer": "^3.0"
    },
    "require-dev": {
        "phpstan/phpstan": "~2.1.0",
        "phpunit/phpunit": "~10.5.0",
        "squizlabs/php_codesniffer": "~3.13.0",
        "yiisoft/yii2-debug": "^2.1",
        "yiisoft/yii2-gii": "^2.2"
    },
    "autoload-dev": {
        "psr-4": {
            "tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "yiisoft/yii2-composer": true
        },
        "process-timeout": 1800,
        "sort-packages": true
    },
    "scripts": {
        "test:prepare": "php tests/bin/install-test.php --keep",
        "test": "phpunit --configuration phpunit.xml.dist",
        "test:install": "php tests/bin/install-test.php",
        "lint": "php tests/bin/php-lint.php",
        "style": "phpcs --standard=phpcs.xml",
        "analyse": "phpstan analyse --configuration=phpstan.neon --no-progress",
        "security:audit": "composer audit --locked --abandoned=report",
        "ci": [
            "@check:composer",
            "@security:audit",
            "@lint",
            "@style",
            "@analyse",
            "@test:prepare",
            "@test",
            "@test:install"
        ],
        "check:composer": "composer validate --strict --no-check-publish"
    },
    "extra": {
        "asset-installer-paths": {
            "npm-asset-library": "vendor/npm",
            "bower-asset-library": "vendor/bower"
        }
    }
}
