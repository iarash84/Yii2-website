YII_ENV=prod
YII_DEBUG=0
# Set this only when the web installer cannot discover the PHP CLI executable.
PHP_CLI_BINARY=
APP_LANGUAGE=fa
ADMIN_LANGUAGE=fa
APP_URL=http://127.0.0.1:8080
SITE_NAME=
SITE_ADDRESS=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=yii2_website
DB_USER=root
DB_PASSWORD=

MAIL_USE_FILE_TRANSPORT=1
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
